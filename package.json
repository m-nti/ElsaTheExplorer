{
  "name": "elsa-the-explorer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Elsa the Explorer \u2014 a card library. The collection is the product; Elsa is the collection mechanism.",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "panda codegen && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:ts": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --coverage --project unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "stylelint": "stylelint \"src/**/*.css\" \"src/**/*.svelte\"",
    "knip": "knip",
    "gate:contrast": "vitest run tests/unit/contrast.test.ts",
    "gate:selectors": "node scripts/selector-diff.mjs",
    "canon": "node scripts/canon-check.mjs",
    "gate:tables": "node scripts/table-integrity.mjs",
    "check:paths": "node scripts/check-paths.mjs",
    "gate:plan-status": "node scripts/plan-status.mjs",
    "canon:strict": "node scripts/canon-check.mjs --strict",
    "test:canon": "vitest run --project canon",
    "photos": "node scripts/photos.mjs",
    "prepare": "panda codegen && node scripts/git-hooks.mjs",
    "gate:unused-css": "node scripts/gate-svelte-css.mjs",
    "jscpd": "jscpd --config jscpd.json .",
    "ci:gates": "node scripts/ci-gates.mjs",
    "verify": "node scripts/verify.mjs",
    "lockfile:check": "npm ci --os=linux --cpu=x64 --dry-run --ignore-scripts --no-audit --no-fund && git diff --exit-code -- package-lock.json"
  },
  "dependencies": {
    "heic2any": "0.0.4",
    "svelte": "5.59.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pandacss/dev": "2.6.0",
    "@pandacss/preset-base": "2.6.0",
    "@pandacss/preset-panda": "2.6.0",
    "@pandacss/vite": "2.6.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "knip": "6.47.0",
    "postcss": "8.5.33",
    "postcss-html": "2.0.1",
    "sharp": "0.35.5",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "stylelint-declaration-strict-value": "1.13.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "jscpd": "5.4.3"
  },
  "packageManager": "npm@11.6.2"
}
