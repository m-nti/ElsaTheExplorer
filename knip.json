{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "index.html",
    "src/lib/stores/*.svelte.ts",
    "tests/unit/**/*.test.ts",
    "tests/canon/**/*.test.mjs",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,svelte}",
    "design/**/*.ts",
    "tests/**/*.{ts,mjs}",
    "scripts/**/*.mjs",
    "*.config.{ts,js}"
  ],
  "ignore": [
    "tests/canon/fixtures/**"
  ],
  "ignoreBinaries": [
    "php"
  ],
  "ignoreDependencies": [
    "heic2any"
  ],
  "ignoreExportsUsedInFile": true
}
